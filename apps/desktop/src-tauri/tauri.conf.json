{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontor",
  "version": "1.0.0",
  "identifier": "de.jadenk.kontor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kontor",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "JadenK IT-Entwicklung",
    "category": "Business",
    "shortDescription": "Kunden, Produkte, Rabatte und Rechnungen verwalten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["German"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
