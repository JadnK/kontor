    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.2.1",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.38",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
