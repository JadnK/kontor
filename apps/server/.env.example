# Verbindung zur PostgreSQL-Datenbank
DATABASE_URL=postgres://kontor:kontor@localhost:5432/kontor

# Pflicht, mind. 32 Zeichen: openssl rand -hex 32
# Verschlüsselt gespeicherte Passwörter und API-Schlüssel. Nicht nachträglich ändern.
APP_SECRET=

# Öffentliche Adresse des Servers (Einladungscodes, Kundenportal, Zahlungslinks, Webhooks).
# Leer = aus der Anfrage abgeleitet (reicht für die Entwicklung).
PUBLIC_URL=https://kontor.example.de

# Einmal-Token für die Ersteinrichtung. Leer = wird beim Start generiert und geloggt.
SETUP_TOKEN=

# Optional
PORT=8080
INSTANCE_NAME=
SESSION_DAYS=30
AUTOMATION_INTERVAL_MINUTES=60
LOG_LEVEL=info
