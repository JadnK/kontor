# Kopieren nach deploy/.env und ausfüllen

# Datenbank-Passwort (frei wählen)
POSTGRES_PASSWORD=

# Mind. 32 Zeichen: openssl rand -hex 32
# Verschlüsselt gespeicherte Passwörter und API-Schlüssel. Danach nicht mehr ändern.
APP_SECRET=

# Öffentliche Adresse des Servers – per https aus dem Internet erreichbar.
# Wird gebraucht für Einladungscodes, Kundenportal, Angebots- und Zahlungslinks,
# Website-Formular, Stripe-Webhook und den automatischen Kontoabruf.
PUBLIC_URL=https://kontor.example.de

# Optional: festes Einrichtungs-Token (sonst wird eins generiert und geloggt)
SETUP_TOKEN=

# Optional: fertiges Image aus GitHub statt lokal bauen
# KONTOR_IMAGE=ghcr.io/dein-github-name/kontor-server:latest

# Optional: Port auf dem Host
KONTOR_PORT=8080
